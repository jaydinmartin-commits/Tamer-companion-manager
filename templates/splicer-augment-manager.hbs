<section class="tcm-splicer-manager">
  <header class="tcm-splicer-summary">
    <div>
      <strong>{{companion.name}}</strong>
      <small>Splicer • Tamer Level {{tamer.level}}</small>
    </div>
    <div class="tcm-splicer-points">
      <span>Total <b>{{total}}</b></span>
      <span>Other Companions <b>{{otherSpent}}</b></span>
      <span>This Companion <b>{{spent}}</b></span>
      <span>Available <b>{{available}}</b></span>
    </div>
  </header>

  {{#if pending}}
    <p class="tcm-splicer-pending"><i class="fa-solid fa-hourglass-half"></i> Changes are pending until the next long rest.</p>
  {{/if}}

  <div class="tcm-splicer-augment-list">
    {{#each augments}}
      <article class="tcm-splicer-augment">
        <img src="{{img}}" alt="">
        <div class="tcm-splicer-augment-info">
          <h3>{{name}}</h3>
          <div class="tcm-splicer-augment-description">{{{description}}}</div>
          <small>{{cost}} point(s){{#if repeatable}} • Repeatable (max {{maxCount}}){{/if}}{{#if minLevelForSecond}} • Second at level {{minLevelForSecond}}{{/if}}</small>
        </div>
        <div class="tcm-splicer-counter">
          <button type="button" data-action="decrement" data-id="{{id}}" {{#unless count}}disabled{{/unless}} aria-label="Remove {{name}}"><i class="fa-solid fa-minus"></i></button>
          <span>{{count}}</span>
          <button type="button" data-action="increment" data-id="{{id}}" aria-label="Add {{name}}"><i class="fa-solid fa-plus"></i></button>
        </div>
      </article>
    {{/each}}
  </div>

  <footer class="tcm-splicer-footer">
    <button type="button" data-action="cancel"><i class="fa-solid fa-xmark"></i> Cancel</button>
    <button type="button" data-action="save" class="primary"><i class="fa-solid fa-floppy-disk"></i> Save Selection</button>
  </footer>
</section>