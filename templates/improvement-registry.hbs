<section class="tcm-registry">
  <header class="tcm-registry-header">
    <div><h2>Bespoke Companion Improvements</h2><p>Register the standard Monster Trainer Improvement pool and additional bespoke companion improvement trees. Any Item can be registered.</p></div>
    <button type="button" data-action="addTree"><i class="fa-solid fa-plus"></i> New Tree</button>
  </header>

  <div class="tcm-standard-drop-zone">
    <i class="fa-solid fa-list-check"></i>
    <strong>Standard Monster Trainer Improvements</strong>
    <small>Drop the Item or Folder containing your base Monster Trainer Improvements here. Folders are scanned recursively.</small>
    {{#if standardSources.length}}
      <ul class="tcm-tree-sources">{{#each standardSources}}<li><span>{{name}} <small>({{type}})</small></span><button type="button" data-action="removeStandardSource" data-uuid="{{uuid}}" title="Remove source" aria-label="Remove {{name}}"><i class="fa-solid fa-xmark"></i></button></li>{{/each}}</ul>
    {{else}}
      <p>No standard improvement sources registered.</p>
    {{/if}}
  </div>

  {{#if editing}}
    <form class="tcm-registry-editor">
      <div class="form-group"><label>Tree Name</label><input name="name" value="{{editing.name}}" placeholder="e.g. Khaji Da Improvements"></div>
      <div class="form-group"><label>Companion Name Match</label><input name="matchName" value="{{editing.matchName}}" placeholder="Exact Actor name"></div>
      <div class="tcm-tree-drop-zone"><i class="fa-solid fa-folder-plus"></i><strong>Drop Improvement Items or Folders Here</strong><small>Any Item or Folder is accepted. Folders are scanned recursively.</small></div>
      <ul class="tcm-tree-sources">{{#each editing.sources}}<li><span>{{name}} <small>({{type}})</small></span><button type="button" data-action="removeTreeSource" data-uuid="{{uuid}}" title="Remove source" aria-label="Remove {{name}}"><i class="fa-solid fa-xmark"></i></button></li>{{/each}}</ul>
      <div class="tcm-actions"><button type="button" data-action="saveTree" class="primary">Save Tree</button><button type="button" data-action="cancelEdit">Cancel</button></div>
    </form>
  {{else}}
    <div class="tcm-registry-list">
      {{#each trees}}
        <article class="tcm-registry-card"><div><h3>{{name}}</h3><p>Matches: <strong>{{matchName}}</strong></p><small>{{sources.length}} registered source(s)</small></div><div class="tcm-actions"><button type="button" data-action="editTree" data-id="{{id}}">Edit</button><button type="button" data-action="removeTree" data-id="{{id}}">Remove</button></div></article>
      {{else}}<p>No bespoke improvement trees are registered yet.</p>{{/each}}
    </div>
  {{/if}}
</section>