<section class="tcm-registry">
  <header class="tcm-config-header">
    <div>
      <h2>Register Improvements</h2>
      <p>Register the standard Monster Trainer improvement pool and any bespoke companion improvement trees. Drop Items or Folders from the world to link their rules.</p>
    </div>
    <button type="button" data-action="addTree"><i class="fa-solid fa-plus"></i> New Tree</button>
  </header>

  <section class="tcm-source-panel">
    <div class="tcm-source-panel-heading">
      <div>
        <strong>Standard Monster Trainer Improvements</strong>
        <small>Drop an Item or Folder here. Folders are scanned recursively.</small>
      </div>
      <i class="fa-solid fa-list-check"></i>
    </div>
    <div class="tcm-standard-drop-zone">
      <span>Drop Item or Folder</span>
      <small>These sources provide the normal improvement pool.</small>
    </div>
    {{#if standardSources.length}}
      <ul class="tcm-tree-sources">
        {{#each standardSources}}
          <li>
            <span>{{name}} <small>({{type}})</small></span>
            <button type="button" data-action="removeStandardSource" data-uuid="{{uuid}}" title="Remove source" aria-label="Remove {{name}}"><i class="fa-solid fa-xmark"></i></button>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="tcm-config-empty-note">No standard improvement source registered.</p>
    {{/if}}
  </section>

  {{#if editing}}
    <form class="tcm-registry-editor">
      <div class="tcm-editor-heading">
        <div>
          <strong>{{#if editing.name}}Edit Improvement Tree{{else}}New Improvement Tree{{/if}}</strong>
          <small>Identify the companion first, then link its improvement Items.</small>
        </div>
        <i class="fa-solid fa-tree"></i>
      </div>

      <label>Tree Name<input name="name" value="{{editing.name}}" placeholder="e.g. Khaji Da Improvements"></label>
      <label>Actor Identifier<input name="matchIdentifier" value="{{editing.matchIdentifier}}" placeholder="Recommended: D&amp;D5e Actor identifier"><small>Preferred because it remains valid if the companion is renamed.</small></label>
      <label>Companion Name Fallback<input name="matchName" value="{{editing.matchName}}" placeholder="Exact Actor name"><small>Used only when no Actor Identifier is configured.</small></label>

      <div class="tcm-tree-drop-zone">
        <i class="fa-solid fa-folder-plus"></i>
        <strong>Drop Improvement Items or Folders</strong>
        <small>Folders are scanned recursively.</small>
      </div>

      <ul class="tcm-tree-sources">
        {{#each editing.sources}}
          <li>
            <span>{{name}} <small>({{type}})</small></span>
            <button type="button" data-action="removeTreeSource" data-uuid="{{uuid}}" title="Remove source" aria-label="Remove {{name}}"><i class="fa-solid fa-xmark"></i></button>
          </li>
        {{/each}}
      </ul>

      <div class="tcm-actions">
        <button type="button" data-action="cancelEdit">Cancel</button>
        <button type="button" data-action="saveTree" class="primary">Save Tree</button>
      </div>
    </form>
  {{else}}
    <div class="tcm-registry-list">
      {{#each trees}}
        <article class="tcm-registry-card">
          <div>
            <h3>{{name}}</h3>
            {{#if matchIdentifier}}<p><span>Identifier</span> {{matchIdentifier}}</p>{{/if}}
            {{#if matchName}}<p><span>Name fallback</span> {{matchName}}</p>{{/if}}
            <small>{{sources.length}} registered source{{#unless sources.length}}s{{/unless}}</small>
          </div>
          <div class="tcm-actions">
            <button type="button" data-action="editTree" data-id="{{id}}">Edit</button>
            <button type="button" data-action="removeTree" data-id="{{id}}">Remove</button>
          </div>
        </article>
      {{else}}
        <p class="tcm-config-empty-note">No bespoke improvement trees are registered yet.</p>
      {{/each}}
    </div>
  {{/if}}
</section>