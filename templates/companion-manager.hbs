<section class="tcm-root">
  <div class="tcm-toolbar">
    <div class="tcm-toolbar-left">
      <div class="tcm-family-summary">
        <span class="tcm-summary-label">Pocket Family</span>
        <strong>{{pocketFamily.occupied}} / {{pocketFamily.slots}}</strong>
      </div>
      <button type="button" data-action="addCompanion"><i class="fa-solid fa-plus"></i><span>Add Companion</span></button>
      <button type="button" data-action="refresh"><i class="fa-solid fa-rotate"></i><span>Refresh</span></button>
    </div>
    <div class="tcm-paradigm-display" aria-label="Training paradigm">
      {{#if splicer.enabled}}<span title="Splicer"><i class="fa-solid fa-dna"></i> Splicer</span>{{/if}}
    </div>
  </div>

  <div class="tcm-companion-grid">
    {{#each companions}}
      <article class="tcm-card {{#if summoned}}is-summoned{{/if}}">
        <div class="tcm-card-image">
          <img src="{{img}}" alt="{{name}}">
          <span class="tcm-status {{#if summoned}}summoned{{else}}{{#if vessel}}vessel{{else}}unassigned{{/if}}{{/if}}">
            {{#if summoned}}Summoned{{else}}{{#if vessel}}In Vessel{{else}}No Vessel{{/if}}{{/if}}
          </span>
        </div>

        <div class="tcm-card-body">
          <div class="tcm-card-heading">
            <div class="tcm-card-identity">
              <h3>{{name}}</h3>
              <div class="tcm-type">{{type}}</div>
            </div>
            <button type="button" class="tcm-improvement-button" data-action="trainCompanion" data-index="{{index}}" title="Choose Improvements" aria-label="Choose Improvements for {{name}}" {{#unless linked}}disabled{{/unless}} {{#unless progression.target}}disabled{{/unless}}>
              <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
              <span>{{progression.chosen}} / {{progression.target}}</span>
            </button>
          </div>

          <div class="tcm-stats">
            <div><span>HP</span><strong>{{hp}} / {{hpMax}}</strong></div>
            <div><span>AC</span><strong>{{ac}}</strong></div>
          </div>

          <div class="tcm-vessel-control {{#unless vessel}}is-unassigned{{/unless}}">
            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
            <span class="tcm-vessel-label">Vessel</span>
            <select data-tcm-vessel data-index="{{index}}" title="{{#if vessel}}Replace vessel{{else}}Assign vessel{{/if}}">
              <option value="">{{#if vessel}}Unassign{{else}}Assign Vessel{{/if}}</option>
              {{#each vessels}}
                <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}{{#if equipped}} — Equipped{{/if}}</option>
              {{/each}}
            </select>
            {{#if vessel}}
              <button type="button" class="tcm-vessel-clear" data-action="clearVessel" data-index="{{index}}" title="Unbind vessel" aria-label="Unbind vessel">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
              </button>
            {{/if}}
          </div>

          {{#if splicer.enabled}}
            <div class="tcm-paradigm-row">
              <span><i class="fa-solid fa-dna" aria-hidden="true"></i> Splicer Augments</span>
              <strong>{{splicer.spent}} pts{{#if splicer.pending}} · Pending{{/if}}</strong>
              <button type="button" data-action="openSplicer" data-index="{{index}}" class="primary" {{#unless linked}}disabled{{/unless}}>
                Choose
              </button>
            </div>
          {{/if}}

          <div class="tcm-actions">
            <button type="button" data-action="openCompanion" data-index="{{index}}" {{#unless linked}}disabled{{/unless}}>
              <i class="fa-solid fa-file-lines"></i><span>Manage</span>
            </button>
            {{#if summoned}}
              <button type="button" data-action="dismissCompanion" data-index="{{index}}" class="primary">
                <i class="fa-solid fa-box"></i><span>Dismiss</span>
              </button>
            {{else}}
              <button type="button" data-action="summonCompanion" data-index="{{index}}" class="primary" {{#unless linked}}disabled{{/unless}}>
                <i class="fa-solid fa-wand-sparkles"></i><span>Summon</span>
              </button>
            {{/if}}
            <button type="button" data-action="unlinkCompanion" data-index="{{index}}" title="Unlink" aria-label="Unlink companion">
              <i class="fa-solid fa-link-slash"></i>
            </button>
          </div>
        </div>
      </article>
    {{/each}}

    {{#each pocketFamily.empty}}
      <article class="tcm-empty-slot tcm-drop-zone">
        <i class="fa-solid fa-plus"></i>
        <strong>Empty Companion Slot</strong>
        <small>Drag an Actor here to bond it.</small>
      </article>
    {{/each}}

    {{#unless companions.length}}
      <div class="tcm-empty-state">
        <i class="fa-solid fa-paw"></i>
        <h3>No Companions</h3>
        <p>Drag an Actor here to bond it, or use <strong>Add Companion</strong>.</p>
      </div>
    {{/unless}}
  </div>
</section>
