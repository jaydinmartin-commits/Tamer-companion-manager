<section class="tcm-root">
  <header class="tcm-header">
    <div class="tcm-tamer">
      <img src="{{tamer.img}}" alt="{{tamer.name}}" class="tcm-tamer-image">
      <div>
        <h2>{{tamer.name}}</h2>
        <div class="tcm-subtitle">Tamer Level {{tamer.level}}</div>
      </div>
    </div>
    <div class="tcm-family-summary">
      <span class="tcm-summary-label">Pocket Family</span>
      <strong>{{pocketFamily.occupied}} / {{pocketFamily.slots}}</strong>
    </div>
  </header>

  <div class="tcm-toolbar">
    <button type="button" data-action="addCompanion"><i class="fa-solid fa-plus"></i><span>Add Companion</span></button>
    <button type="button" data-action="refresh"><i class="fa-solid fa-rotate"></i><span>Refresh</span></button>
    <button type="button" data-action="openTamer"><i class="fa-solid fa-user"></i><span>Tamer Sheet</span></button>
  </div>

    <div class="tcm-companion-grid">
    {{#each companions}}
      <article class="tcm-card {{#if summoned}}is-summoned{{/if}}">
        <div class="tcm-card-image">
          <img src="{{img}}" alt="{{name}}">
          <span class="tcm-status {{#if summoned}}summoned{{else}}vessel{{/if}}">
            {{#if summoned}}Summoned{{else}}In Vessel{{/if}}
          </span>
        </div>
        <div class="tcm-card-body">
          <div class="tcm-card-heading">
            <div>
              <h3>{{name}}</h3>
              <div class="tcm-type">{{type}}</div>
            </div>
            <span class="tcm-slot">Slot {{slot}}</span>
          </div>

          <div class="tcm-stats">
            <div><span>HP</span><strong>{{hp}} / {{hpMax}}</strong></div>
            <div><span>AC</span><strong>{{ac}}</strong></div>
            <div class="tcm-vessel-field {{#unless vessel}}unavailable{{/unless}}"><span>Vessel</span>{{#if vessel}}<strong>{{vessel}}</strong>{{else}}<strong>Summon Unavailable</strong>{{/if}}</div>
          </div>

          <div class="tcm-improvements">
  <div><span>Improvements</span><strong>{{progression.chosen}} / {{progression.target}}</strong></div>
  <button type="button" data-action="trainCompanion" data-index="{{index}}" class="primary" {{#unless linked}}disabled{{/unless}} {{#if progression.target}}{{else}}disabled{{/if}}>
    <i class="fa-solid fa-graduation-cap"></i><span>Choose Improvement</span>
  </button>
</div>

          <div class="tcm-vessel-picker">
            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
            <select data-tcm-vessel data-index="{{index}}" title="Choose companion vessel">
              <option value="">No vessel assigned</option>
              {{#each vessels}}
                <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}{{#if equipped}} — Equipped{{/if}}</option>
              {{/each}}
            </select>
          </div>
          <div class="tcm-actions">
            <button type="button" data-action="openCompanion" data-index="{{index}}" {{#unless linked}}disabled{{/unless}}>
              <i class="fa-solid fa-file-lines"></i><span>Manage</span>
            </button>

            {{#if summoned}}
              <button type="button" data-action="dismissCompanion" data-index="{{index}}" class="primary">
                <i class="fa-solid fa-box"></i><span>Dismiss</span>
              </button>
            {{else}}
              <button type="button" data-action="summonCompanion" data-index="{{index}}" class="primary" {{#unless linked}}disabled{{/unless}}>
                <i class="fa-solid fa-wand-sparkles"></i><span>Summon</span>
              </button>
            {{/if}}

            {{#if vessel}}<button type="button" data-action="clearVessel" data-index="{{index}}" title="Remove vessel assignment"><i class="fa-solid fa-box"></i></button>{{/if}}
            <button type="button" data-action="unlinkCompanion" data-index="{{index}}" title="Unlink">
              <i class="fa-solid fa-link-slash"></i>
            </button>
          </div>
        </div>
      </article>
    {{/each}}

    {{#each pocketFamily.empty}}
      <article class="tcm-empty-slot tcm-drop-zone">
        <i class="fa-solid fa-plus"></i>
        <span>Empty Pocket Family Slot</span>
        <small>Drag an Actor here to bond it.</small>
      </article>
    {{/each}}

    {{#unless companions.length}}
      <div class="tcm-empty-state">
        <i class="fa-solid fa-paw"></i>
        <h3>No Companions Linked</h3>
        <p>Drag an Actor onto an empty Pocket Family slot, or use <strong>Add Companion</strong>.</p>
      </div>
    {{/unless}}
  </div>

  <div class="tcm-bottom-info">
    <div class="tcm-soul-bond">
      <div class="tcm-soul-bond-heading">
        <span><i class="fa-solid fa-heart-pulse"></i><strong>Soul Bond</strong></span>
        <strong>{{soulBond.current}} / {{soulBond.max}}</strong>
      </div>
    </div>
  </div>

  <footer class="tcm-footer">
    <span><i class="fa-solid fa-database"></i> Relationship data is stored on the Tamer Actor.</span>
    <span>v0.1.71</span>
  </footer>
</section>
