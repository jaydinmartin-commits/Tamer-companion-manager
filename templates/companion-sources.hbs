<form class="tcm-source-registry">
  <header class="tcm-config-header">
    <div>
      <h2>Companion Sources</h2>
      <p>Select the Actor compendiums that players may browse from <strong>Add Companion</strong>.</p>
    </div>
    <strong>{{selectedCount}} selected</strong>
  </header>

  <div class="tcm-source-registry-list">
    {{#each packs}}
      <label class="tcm-source-pack {{#unless visible}}is-hidden-source{{/unless}}">
        <input type="checkbox" name="companionSourcePack" value="{{collection}}" {{#if selected}}checked{{/if}}>
        <span class="tcm-source-pack-check"></span>
        <span class="tcm-source-pack-text">
          <strong>{{title}}</strong>
          <small>{{#if packageName}}{{packageName}}{{else}}World compendium{{/if}}</small>
          <em>{{#unless visible}}Hidden from players · {{/unless}}{{collection}}</em>
        </span>
      </label>
    {{else}}
      <div class="tcm-source-registry-empty">No Actor compendiums are currently available.</div>
    {{/each}}
  </div>

  <footer class="tcm-config-footer">
    <span>Only Actor compendiums are listed.</span>
    <span></span>
    <button type="button" data-action="cancel">Cancel</button>
    <button type="button" data-action="save" class="primary">Save</button>
  </footer>
</form>